{
  "appId": "com.azzmedia.elitetvplay",
  "appName": "Ozzie-Player",
  "webDir": "www/public",
  "bundledWebRuntime": false,
  "orientation": "landscape",
  "server": {
    "androidScheme": "http",
    "cleartext": true
  },
  "ios": {
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#050505",
      "overlaysWebView": false
    }
  }
}
